# =========================================================================
# GIMP PRO DARK STYLE (ALIGNÉ SUR LA PALETTE OFFICIELLE SOMBRE)
# =========================================================================
style "gimp_dark_theme" {
    bg[NORMAL]        = @bg_color_dark
    bg[PRELIGHT]      = shade (1.12, @bg_color_dark)
    bg[SELECTED]      = @selected_bg_color
    bg[INSENSITIVE]   = shade (0.85, @bg_color_dark)
    bg[ACTIVE]        = shade (0.90, @bg_color_dark)

    fg[NORMAL]        = @fg_color_dark
    fg[PRELIGHT]      = @fg_color_dark
    fg[SELECTED]      = @selected_fg_color
    fg[INSENSITIVE]   = shade (0.55, @fg_color_dark)
    fg[ACTIVE]        = @fg_color_dark

    text[NORMAL]      = @fg_color_dark
    text[PRELIGHT]    = @fg_color_dark
    text[SELECTED]    = @selected_fg_color
    text[INSENSITIVE] = shade (0.55, @fg_color_dark)
    text[ACTIVE]      = @fg_color_dark

    base[NORMAL]      = @base_color
    base[PRELIGHT]    = shade (1.05, @base_color)
    base[SELECTED]    = @selected_bg_color
    base[INSENSITIVE] = shade (0.85, @base_color)
    base[ACTIVE]      = @base_color

    engine "murrine" {
        gradient_shades   = {1.0, 1.0, 1.0, 1.0}
        contrast          = 1.0
        focus_color       = @selected_bg_color
        lightborder_shade = 1.0
    }
}

widget_class "*Gimp*" style "gimp_dark_theme"
class "*Gimp*" style "gimp_dark_theme"
widget_class "*GimpDisplayShell*" style "gimp_dark_theme"
widget_class "*GimpToolbox*" style "gimp_dark_theme"
widget_class "*GimpMenuDock*" style "gimp_dark_theme"
widget_class "*GimpDock*" style "gimp_dark_theme"
widget_class "*GimpDialog*" style "gimp_dark_theme"
widget_class "*Gimp*<GtkMenuBar>*" style "menubar"
widget_class "*Gimp*<GtkMenu>*" style "menu"
widget_class "*Gimp*<GtkMenuItem>*" style "menu_item"

