# XFCE : the window displayed with the Alt-tab key combinaison 
style "xfwm-tabwin" {
	Xfwm4TabwinWidget::border-width = 0
	Xfwm4TabwinWidget::icon-size = 48

	bg[NORMAL] = @bg_color_dark
	fg[NORMAL] = @fg_color_dark

	engine "murrine" {
		border_shades = {0.98, 0.82}
	}
}
widget "xfwm4-tabwin*"				style "xfwm-tabwin"

# XFCE : logout window settings
style "xfsm-logout" {
	bg[NORMAL]			= @bg_color_dark
	bg[ACTIVE]			= @bg_color_dark
	bg[PRELIGHT]		= shade (1.1, @bg_color_dark)
	bg[SELECTED]		= shade (0.5, @bg_color_dark)
	bg[INSENSITIVE]		= shade (1.3, @bg_color_dark)

	fg[NORMAL]			= @fg_color_dark
	fg[PRELIGHT]		= @fg_color_dark

	text[NORMAL]		= @fg_color_dark

	engine "murrine" {
	}
}

style "xfsm-logout-button" {
	bg[NORMAL]			= shade (1.17, @bg_color_dark)
	bg[PRELIGHT]		= mix (0.80, shade (1.05, @bg_color_dark), shade (1.1, @selected_bg_color))
	bg[ACTIVE]			= mix (0.60, shade (1.10, @bg_color_dark), shade (0.96, @selected_bg_color))

	fg[ACTIVE]			= @fg_color_dark

	engine "murrine" {
		border_shades		= {1.01, 0.8}
		reliefstyle			= 0
		lightborder_shade = 1.0
	}
}
widget_class "*XfsmLogoutDialog*"			style "xfsm-logout"
widget_class "*XfsmLogoutDialog*GtkButton"	style "xfsm-logout-button"

