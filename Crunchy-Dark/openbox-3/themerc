# Crunchy Openbox & Labwc Theme
# Perfect Visual Alignment with XFWM4 & Metacity

padding.width: 4
padding.height: 5
window.handle.width: 0
border.width: 1
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap.x: -3
menu.overlap.y: 3
window.frameColor: #18181b
window.*.client.color: #242320
*.text.justify: center

menu.items.font: Ubuntu,Sans:size=10:shadow=n
menu.title.text.font: Ubuntu,Sans:size=10:bold:shadow=n
window.active.label.text.font: Ubuntu,Sans:size=10:bold:shadow=y:shadowtint=25:shadowoffset=1
window.inactive.label.text.font: Ubuntu,Sans:size=10:shadow=n
osd.label.text.font: Ubuntu,Sans:size=10:bold:shadow=n

*.bg.highlight: 0
*.bg.shadow: 0
window.*.bg.highlight: 0
window.*.bg.shadow: 0
window.active.title.bg.highlight: 0
window.active.title.bg.shadow: 0

# Menu Déroulant avec Dégradé Horizontal Harmonisé
menu.border: flat border
menu.border.color: #18181b
menu.border.width: 1

menu.title.bg: flat gradient horizontal
menu.title.bg.color: #242320
menu.title.bg.colorTo: #4d4c46
menu.title.text.color: #ffffff
menu.title.bg.border.color: #18181b

menu.items.bg: flat gradient horizontal
menu.items.bg.color: #22211e
menu.items.bg.colorTo: #484741
menu.items.text.color: #ffffff
menu.items.disabled.text.color: #666666

menu.items.active.bg: flat gradient horizontal
menu.items.active.bg.color: #206e33
menu.items.active.bg.colorTo: #48dc6f
menu.items.active.text.color: #ffffff

menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 4
menu.separator.color: #3c3b38

# Active Windows (Identique XFWM4 / Metacity)
window.active.border.color: #18181b
window.active.title.separator.color: #18181b

window.active.title.bg: flat gradient vertical
window.active.title.bg.color: #34332f
window.active.title.bg.colorTo: #22211e

window.active.label.bg: parentrelative
window.active.label.text.color: #ffffff

window.active.button.*.bg: parentrelative
window.active.button.*.image.color: #d9d9d9

window.active.button.*.hover.bg: flat solid
window.active.button.*.hover.bg.color: #35A854
window.active.button.*.hover.image.color: #ffffff

window.active.button.*.pressed.bg: flat solid
window.active.button.*.pressed.bg.color: #206e33
window.active.button.*.pressed.image.color: #ffffff

window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #555555

window.active.handle.bg: flat solid
window.active.handle.bg.color: #242320
window.active.grip.bg: flat solid
window.active.grip.bg.color: #242320

# Inactive Windows
window.inactive.border.color: #18181b
window.inactive.title.separator.color: #18181b

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #1c1b19

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #777777

window.inactive.button.*.bg: parentrelative
window.inactive.button.*.image.color: #777777

window.inactive.button.*.hover.bg: flat solid
window.inactive.button.*.hover.bg.color: #2c2b28
window.inactive.button.*.hover.image.color: #ffffff

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #1c1b19
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #1c1b19

# OSD (On Screen Display)
osd.border.width: 1
osd.border.color: #18181b
osd.bg: flat solid
osd.bg.color: #242320
osd.label.bg: parentrelative
osd.label.text.color: #ffffff
osd.hilight.bg: flat solid
osd.hilight.bg.color: #35A854
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #18181b
